{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiefmind",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],

  // Static site: built by `npm run build` into ./dist and served directly by the edge.
  // Requests that don't match a file fall through to the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://chiefmind.io,https://www.chiefmind.io",
    "MAX_BODY_BYTES": "16384",
    "ENFORCE_HTTPS": "true"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chiefmind_intake",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "worker/migrations"
    }
  ],

  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
