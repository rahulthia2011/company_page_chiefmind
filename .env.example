# URL of the intake endpoint. Defaults to `/intake` (same-origin) which works when
# the site and the Worker are deployed together via the root wrangler.jsonc.
# Override to an absolute HTTPS URL only if the Worker is on a different origin.
VITE_INTAKE_ENDPOINT=/intake

# Cloudflare Turnstile site key (public). Get from dash.cloudflare.com > Turnstile.
# Leave unset in dev to skip the widget entirely.
VITE_TURNSTILE_SITE_KEY=
